		{
			"name": "🔐 Authentication",
			"item": [
				{
					"name": "Register",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.status === 'Created' || pm.response.status === 'OK') {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.token) {",
									"        pm.globals.set('token', jsonData.token);",
									"        console.log('Token saved:', jsonData.token);",
									"    }",
									"    if (jsonData.userId) {",
									"        pm.globals.set('userId', jsonData.userId);",
									"        console.log('User ID saved:', jsonData.userId);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"firstName\": \"Test\",\n    \"lastName\": \"User\",\n    \"email\": \"testuser@example.com\",\n    \"password\": \"password123\"\n}"
						},
