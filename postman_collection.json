		{
			"name": "🔐 Authentication",
			"item": [
									{
						"name": "Register",
						"event": [
							{
								"listen": "test",
								"script": {
									"exec": [
										"if (pm.response.status === 'Created' || pm.response.status === 'OK') {",
										"    var jsonData = pm.response.json();",
										"    if (jsonData.token) {",
										"        pm.globals.set('token', jsonData.token);",
										"        console.log('Token saved:', jsonData.token);",
										"    }",
										"    // L'API auth retourne l'email mais pas l'ID directement",
										"    // Nous pouvons donc stocker l'email comme identifiant",
										"    if (jsonData.email) {",
										"        // Un vrai ID sera retourné lors d'appels utilisateur ultérieurs",
										"        pm.globals.set('userEmail', jsonData.email);",
										"    }",
										"}"
									],
									"type": "text/javascript"
								}
							}
						],
						"request": {
							"method": "POST",
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"body": {
								"mode": "raw",
								"raw": "{\n    \"firstName\": \"Test\",\n    \"lastName\": \"User\",\n    \"email\": \"testuser@example.com\",\n    \"password\": \"password123\"\n}"
							},
							"url": {
								"raw": "{{baseUrl}}/api/auth/register",
								"host": ["{{baseUrl}}"],
								"path": ["api", "auth", "register"]
							}
